{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cataran.invalid/contracts/v1/platform.schema.json",
  "title": "Cataran Platform Contracts v1.0.0",
  "description": "Proposed machine-readable contract bundle. Not canonical until Architecture Owner accepts issue #32.",
  "$defs": {
    "identity_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "principal",
        "tenant_id",
        "project_id",
        "role_bindings",
        "policy_version",
        "verified_at",
        "trace_id"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "principal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_type",
            "actor_id",
            "issuer",
            "subject"
          ],
          "properties": {
            "actor_type": {
              "type": "string",
              "enum": [
                "user",
                "agent",
                "service"
              ]
            },
            "actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "issuer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "membership_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "value"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "task_id",
        "tenant_id",
        "project_id",
        "actor",
        "task_type",
        "state",
        "idempotency_key",
        "request_digest",
        "policy_version",
        "created_at",
        "updated_at",
        "trace_id"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_type",
            "actor_id"
          ],
          "properties": {
            "actor_type": {
              "type": "string",
              "enum": [
                "user",
                "agent",
                "service"
              ]
            },
            "actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "issuer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "task_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "awaiting_approval",
            "succeeded",
            "failed",
            "cancelled",
            "blocked",
            "outcome_unknown"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parent_task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "result_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "task_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "event_id",
        "task_id",
        "tenant_id",
        "sequence",
        "event_type",
        "actor",
        "occurred_at",
        "trace_id",
        "payload_digest"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "type": "string",
          "enum": [
            "task.created",
            "task.started",
            "task.awaiting_approval",
            "task.approved",
            "task.denied",
            "task.succeeded",
            "task.failed",
            "task.cancelled",
            "task.blocked",
            "task.outcome_unknown",
            "task.reconciled",
            "task.retry_scheduled",
            "task.evidence_attached"
          ]
        },
        "from_state": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "awaiting_approval",
                "succeeded",
                "failed",
                "cancelled",
                "blocked",
                "outcome_unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "to_state": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "awaiting_approval",
                "succeeded",
                "failed",
                "cancelled",
                "blocked",
                "outcome_unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_type",
            "actor_id"
          ],
          "properties": {
            "actor_type": {
              "type": "string",
              "enum": [
                "user",
                "agent",
                "service"
              ]
            },
            "actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "issuer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "causation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "approval_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "approval_id",
        "tenant_id",
        "task_id",
        "approver",
        "action",
        "stage_digest",
        "decision",
        "policy_version",
        "human_decision",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_type",
            "actor_id",
            "issuer",
            "subject"
          ],
          "properties": {
            "actor_type": {
              "const": "user"
            },
            "actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "issuer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stage_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "denied",
            "expired",
            "revoked"
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "human_decision": {
          "const": true
        },
        "rationale_code": {
          "type": "string",
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "tool_invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "invocation_id",
        "tenant_id",
        "task_id",
        "gateway",
        "connector_id",
        "connector_revision",
        "tool_name",
        "arguments_digest",
        "side_effect_class",
        "authorization_decision",
        "requested_at",
        "trace_id"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "gateway": {
          "const": "IM19"
        },
        "connector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connector_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tool_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "arguments_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "side_effect_class": {
          "type": "string",
          "enum": [
            "read_only",
            "write",
            "destructive"
          ]
        },
        "authorization_decision": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ]
        },
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "audit_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "result_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outcome_certainty": {
          "type": "string",
          "enum": [
            "known",
            "unknown"
          ]
        }
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "evidence_id",
        "tenant_id",
        "task_id",
        "evidence_type",
        "source_ref",
        "source_sha256",
        "captured_at",
        "provenance"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "document",
            "retrieval_chunk",
            "tool_result",
            "model_output",
            "execution_artifact",
            "test_report",
            "approval",
            "audit_record"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "page_start": {
          "type": "integer",
          "minimum": 1
        },
        "page_end": {
          "type": "integer",
          "minimum": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "producer",
            "producer_version"
          ],
          "properties": {
            "producer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "producer_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "model_id": {
              "type": "string",
              "maxLength": 256
            },
            "ingestion_version": {
              "type": "string",
              "maxLength": 128
            },
            "parent_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "error_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "error_id",
        "code",
        "safe_message",
        "retryable",
        "outcome_certainty",
        "trace_id",
        "occurred_at"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "error_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
        },
        "safe_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        },
        "outcome_certainty": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "details_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "a2a_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "dispatch_id",
        "task_id",
        "tenant_id",
        "source_service",
        "target_service",
        "idempotency_key",
        "request_digest",
        "trace_id",
        "created_at"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "dispatch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "callback_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
