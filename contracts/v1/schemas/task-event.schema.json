{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cataran.invalid/contracts/v1/task-event.schema.json",
  "title": "Cataran Append-only Task Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "task_id",
    "tenant_id",
    "sequence",
    "event_type",
    "actor",
    "occurred_at",
    "trace_id",
    "payload_digest"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "task.created",
        "task.started",
        "task.awaiting_approval",
        "task.approved",
        "task.denied",
        "task.succeeded",
        "task.failed",
        "task.cancelled",
        "task.blocked",
        "task.outcome_unknown",
        "task.reconciled",
        "task.retry_scheduled",
        "task.evidence_attached"
      ]
    },
    "from_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "queued",
        "running",
        "awaiting_approval",
        "succeeded",
        "failed",
        "cancelled",
        "blocked",
        "outcome_unknown",
        null
      ]
    },
    "to_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "queued",
        "running",
        "awaiting_approval",
        "succeeded",
        "failed",
        "cancelled",
        "blocked",
        "outcome_unknown",
        null
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "user",
            "agent",
            "service"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "causation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
