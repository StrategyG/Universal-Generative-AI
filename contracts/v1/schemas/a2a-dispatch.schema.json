{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cataran.invalid/contracts/v1/a2a-dispatch.schema.json",
  "title": "Cataran Agent-to-Agent Dispatch Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "dispatch_id",
    "task_id",
    "tenant_id",
    "source_service",
    "target_service",
    "idempotency_key",
    "request_digest",
    "trace_id",
    "created_at"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target_service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "callback_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
