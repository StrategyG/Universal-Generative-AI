{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cataran.invalid/contracts/v1/error-envelope.schema.json",
  "title": "Cataran Safe Error Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "error_id",
    "code",
    "safe_message",
    "retryable",
    "outcome_certainty",
    "trace_id",
    "occurred_at"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "error_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "safe_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "retryable": {
      "type": "boolean"
    },
    "outcome_certainty": {
      "type": "string",
      "enum": [
        "known",
        "unknown",
        "not_applicable"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "details_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
