{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cataran.invalid/contracts/v1/evidence-record.schema.json",
  "title": "Cataran Evidence and Provenance Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "evidence_id",
    "tenant_id",
    "task_id",
    "evidence_type",
    "source_ref",
    "source_sha256",
    "captured_at",
    "provenance"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "document",
        "retrieval_chunk",
        "tool_result",
        "model_output",
        "execution_artifact",
        "test_report",
        "approval",
        "audit_record"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "page_start": {
      "type": "integer",
      "minimum": 1
    },
    "page_end": {
      "type": "integer",
      "minimum": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "producer_version"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "producer_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_id": {
          "type": "string",
          "maxLength": 256
        },
        "ingestion_version": {
          "type": "string",
          "maxLength": 128
        },
        "parent_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        }
      }
    }
  }
}
