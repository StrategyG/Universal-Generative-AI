{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cataran.invalid/contracts/v1/approval-receipt.schema.json",
  "title": "Cataran Human Approval Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "approval_id",
    "tenant_id",
    "task_id",
    "approver",
    "action",
    "stage_digest",
    "decision",
    "policy_version",
    "human_decision",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id",
        "issuer",
        "subject"
      ],
      "properties": {
        "actor_type": {
          "const": "user"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "stage_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "denied",
        "expired",
        "revoked"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "human_decision": {
      "const": true
    },
    "rationale_code": {
      "type": "string",
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
