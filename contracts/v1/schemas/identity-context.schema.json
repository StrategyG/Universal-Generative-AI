{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cataran.invalid/contracts/v1/identity-context.schema.json",
  "title": "Cataran Verified Identity Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "principal",
    "tenant_id",
    "project_id",
    "role_bindings",
    "policy_version",
    "verified_at",
    "trace_id"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id",
        "issuer",
        "subject"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "user",
            "agent",
            "service"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://[^?#]+$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "membership_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "role_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "value"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
