{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cataran.invalid/contracts/v1/task.schema.json",
  "title": "Cataran Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "tenant_id",
    "project_id",
    "actor",
    "task_type",
    "state",
    "idempotency_key",
    "request_digest",
    "policy_version",
    "created_at",
    "updated_at",
    "trace_id"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id",
        "issuer",
        "subject"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "user",
            "agent",
            "service"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://[^?#]+$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "task_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "state": {
      "type": "string",
      "enum": [
        "received",
        "observing",
        "planning",
        "executing",
        "verifying",
        "awaiting_approval",
        "awaiting_clarification",
        "blocked",
        "failed",
        "succeeded",
        "cancelled",
        "outcome_unknown"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "parent_task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "result_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
