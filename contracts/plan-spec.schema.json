{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strategyg.example/contracts/plan-spec.schema.json",
  "title": "UGAI Workflow Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_type", "goal", "risk_class", "steps", "budgets"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "workflow_type": {
      "enum": ["qa_grounded", "compare_sources", "deep_research", "document_ingestion", "multimodal_generation", "decision_analysis"]
    },
    "goal": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "risk_class": { "enum": ["low", "moderate", "high", "critical"] },
    "data_classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "kind", "depends_on", "timeout_ms", "max_attempts", "side_effect"],
        "properties": {
          "step_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
          "kind": { "enum": ["classify", "retrieve", "rerank", "analyze", "calculate", "tool", "verify", "compose"] },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string" }, "maxItems": 20 },
          "input_refs": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
          "tool_name": { "type": "string", "maxLength": 128 },
          "tool_version": { "type": "string", "maxLength": 64 },
          "tool_args": { "type": "object" },
          "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 120000 },
          "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 2000000 },
          "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
          "required_evidence_tiers": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["approved", "legacy", "private_staging"] }
          },
          "side_effect": { "enum": ["none", "reversible", "external", "destructive"] },
          "requires_confirmation": { "type": "boolean" },
          "policy_reason": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_total_steps", "max_parallel_steps", "max_retrieval_calls", "max_tool_calls", "deadline_ms"],
      "properties": {
        "max_total_steps": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_parallel_steps": { "type": "integer", "minimum": 1, "maximum": 5 },
        "max_retrieval_calls": { "type": "integer", "minimum": 0, "maximum": 8 },
        "max_tool_calls": { "type": "integer", "minimum": 0, "maximum": 12 },
        "max_total_tokens": { "type": "integer", "minimum": 256, "maximum": 200000 },
        "max_cost_microunits": { "type": "integer", "minimum": 0 },
        "deadline_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 }
      }
    },
    "requires_human_review": { "type": "boolean" },
    "policy_version": { "type": "string", "maxLength": 64 }
  }
}