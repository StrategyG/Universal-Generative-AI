APP_NAME=Universal Generative AI
ENVIRONMENT=development
# Local development may use disabled auth. Production startup requires OIDC.
# Supported access-token algorithm: RS256.
AUTH_MODE=disabled
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
OIDC_PROJECTS_CLAIM=project_ids
API_PREFIX=/api/v1
MAX_UPLOAD_BYTES=52428800
ARTIFACT_DIR=artifacts
# mock or diffusers-sdxl
GENERATION_BACKEND=mock
# Optional OpenAI-compatible text inference (OpenAI, vLLM, or local Ollama).
# Remote endpoints must use HTTPS; plain HTTP is allowed only for localhost.
TEXT_GENERATION_BASE_URL=http://localhost:11434/v1
TEXT_GENERATION_API_KEY=
TEXT_GENERATION_MODEL=qwen2.5:14b
# Production requires this exact model revision to be approved in the model registry.
TEXT_GENERATION_MODEL_ID=
TEXT_GENERATION_MODEL_REVISION=
# Configure explicit route preference; only configured providers are used.
TEXT_GENERATION_PROVIDER_ORDER=openai-compatible-chat,openai-compatible-chat-fallback,anthropic-messages,gemini-generate-content
# Optional fallback route. Configure both URL and model; production also requires an approved ID/revision.
TEXT_GENERATION_FALLBACK_BASE_URL=
TEXT_GENERATION_FALLBACK_API_KEY=
TEXT_GENERATION_FALLBACK_MODEL=
TEXT_GENERATION_FALLBACK_MODEL_ID=
TEXT_GENERATION_FALLBACK_MODEL_REVISION=
TEXT_GENERATION_MAX_RETRIES=1
TEXT_GENERATION_RETRY_BACKOFF_SECONDS=0.5
TEXT_GENERATION_TIMEOUT_SECONDS=90

# Native Anthropic Messages API. Production needs immutable model ID/revision.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_ID=
ANTHROPIC_MODEL_REVISION=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2026-10-21

# Native Google Gemini generateContent API. Production needs immutable model ID/revision.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_ID=
GEMINI_MODEL_REVISION=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GPU_REQUIRED=true
# Set a model repo and immutable commit SHA before enabling real inference.
IMAGE_MODEL_ID=
IMAGE_MODEL_REVISION=

# Operator credential for provisioning/revoking workers and production job submission.
# Generate a long random value and store it only in the API secret manager.
WORKER_ADMIN_TOKEN=

# Legacy shared worker credential: development compatibility only; never use in production.
EXTERNAL_WORKER_TOKEN=

# Optional PostgreSQL backend. Apply all ordered files in migrations/ before startup.
# Leave blank for local in-memory development only.
DATABASE_URL=

# Enable strict model approval gate in development; production always enforces it.
MODEL_REGISTRY_ENFORCEMENT=false

# Operator-managed, non-secret UGAI reasoning route catalog (JSON array).
# Each model_id + 40-character revision must already be APPROVED in the PostgreSQL model registry.
# Route metadata cannot approve a model; the API verifies status, license, validation and family.
# Do not put credentials or provider API keys in this JSON.
REASONING_ROUTE_CATALOG_JSON=
REASONING_PERMITTED_DATA_REGIONS=ap-southeast-1
REASONING_MAX_ESTIMATED_COST=1.0
