# Copy to .env. Never commit .env or send its values in chat.
POSTGRES_DB=ugai_rag
POSTGRES_USER=ugai_admin
# Generate a unique 32+ character alphanumeric password locally.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
POSTGRES_PORT=55432

# Local target DSN. Keep the password URL-safe (letters and numbers) or URL-encode it.
TARGET_DATABASE_URL=postgresql://ugai_admin:REPLACE_WITH_RANDOM_SECRET@127.0.0.1:55432/ugai_rag

# Migration-only settings. Leave blank until each credential is configured securely.
SOURCE_DATABASE_URL=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-drive-service-account.json
UGAI_EXPORT_ENCRYPTION_KEY_B64=
