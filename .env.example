APP_NAME=Universal Generative AI
ENVIRONMENT=development
API_PREFIX=/api/v1
MAX_UPLOAD_BYTES=52428800
ARTIFACT_DIR=artifacts
# mock or diffusers-sdxl
GENERATION_BACKEND=mock
GPU_REQUIRED=true
# Set a model repo and immutable commit SHA before enabling real inference.
IMAGE_MODEL_ID=
IMAGE_MODEL_REVISION=

# Operator credential for provisioning/revoking workers and production job submission.
# Generate a long random value and store it only in the API secret manager.
WORKER_ADMIN_TOKEN=

# Legacy shared worker credential: development compatibility only; never use in production.
EXTERNAL_WORKER_TOKEN=

# Optional PostgreSQL backend. Apply all ordered files in migrations/ before startup.
# Leave blank for local in-memory development only.
DATABASE_URL=

# Enable strict model approval gate in development; production always enforces it.
MODEL_REGISTRY_ENFORCEMENT=false
